# ==============================================================================
# mcp_server 本番環境用環境変数テンプレート (.env.example)
#
# Vercel などのホスティング環境にデプロイする際、プロジェクトの設定画面
# (Project Settings > Environment Variables) または本番用 .env に設定してください。
#
# ※シークレットキーは rental_server 側で以下を実行して生成した値と合わせてください:
#   python manage.py gen-secrets
# ==============================================================================

# MCP Server 自身の公開ベースURL (末尾スラッシュなし)
PUBLIC_BASE_URL=https://your-mcp-server.vercel.app

# rental_server の API エンドポイント URL (CGIスクリプトパスを含む)
RENTAL_API_BASE_URL=https://your-domain.sakura.ne.jp/mailmgr/api.cgi/api

# rental_server の 同意画面URL
RENTAL_CONSENT_URL=https://your-domain.sakura.ne.jp/mailmgr/consent.html

# rental_server と共通の API キー (rental_server の API_KEY と同一の値)
RENTAL_API_KEY=your-production-api-key-here

# OAuth トークン署名用秘密鍵 (32文字以上。Vercel 環境変数専用)
OAUTH_SIGNING_KEY=your-oauth-signing-key-here

# rental_server と共通の OAuth Bridge シークレット (rental_server の OAUTH_BRIDGE_SECRET と同一の値)
OAUTH_BRIDGE_SECRET=your-oauth-bridge-secret-here

# ※本番環境では DEV_BYPASS_AUTH は設定しないでください（設定しないことで認証が必須になります）

